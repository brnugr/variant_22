name: Compare Job and Service

on:
  push:
  workflow_dispatch:

jobs:
  comparison:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: demo_password
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Show Job
        run: echo "This is a Job"

      - name: Check Service
        run: |
          pg_isready -h postgres -p 5432 -U postgres

      - name: Success
        run: echo "Workflow completed!"
